// =====================================================================
// ARES-1 參數檔（單位 mm）
// 名稱與 web/index.html 的 DEFAULTS 完全相同，網頁「參數 → 產生 OpenSCAD 參數」
// 輸出的內容可以直接貼進來取代。
//
// 狀態標記： [C] 已確認（使用者提供）  [E] 估計  [M] 待量測  [D] 設計值
// =====================================================================

layout = "B";          // [D] "B" 對角馬達（主方案）/ "A" 同軸後置 / "C" 長頸桅杆
mic_in_head = true;    // [D] INMP441 放頭部（推薦）

// ---------- 底盤與履帶 ----------
innerW        = 110;   // [D] 兩側壁內面距離
wheelbase     = 111.5; // [D] 驅動輪↔惰輪中心距（配合 28 片履帶）
trackW        = 30;    // [D] 履帶寬
trackPitch    = 12.5;  // [D] 履帶節距
sprocketTeeth = 10;    // [D] 鏈輪齒數 → 節圓 40.45 ≈ Ø41 [E]
plateT        = 4;     // [D] 側壁（兼馬達座）厚
trackGap      = 1.5;   // [D] 側壁外面到履帶內緣
trackT        = 5;     // [D] 履帶片厚（插銷處）
grouser       = 1.5;   // [D] 抓地齒高
floorY        = 12;    // [D] 底板下緣離地
floorT        = 2.5;   // [D] 底板厚

// ---------- JGA25-370 ----------
motorD    = 25;        // [C] 本體直徑
motorCan  = 31;        // [C] 馬達段
encLen    = 11;        // [C] 編碼器蓋
gearLen   = 22;        // [E] 減速箱長 L（未標示）
shaftD    = 4;         // [C] 輸出軸
shaftLen  = 12.5;      // [C] 輸出軸突出
motorHole = 17;        // [C] 前端 2×M3 中心距

// ---------- 電池（2S 18650 電池盒） ----------
batL = 70;             // [E]
batW = 40;             // [E]
batH = 25;             // [E]
batZ = -10;            // [D] 電池中心前後位置（負＝往後）

// ---------- 模組 ----------
drvL = 48;  drvW = 30;               // [C] DRV8870 雙路模組 PCB
buckL = 45; buckW = 25; buckH = 18;  // [E] 降壓模組
spkD = 40;  spkH = 20;               // [E] 喇叭

// ---------- 身體 ----------
bodyW  = 110;          // [D]
bodyD  = 100;          // [D]
bodyH  = 96;           // [D]
shellT = 1.6;          // [D] 外殼壁厚（0.4 噴嘴 4 圈）
deckT  = 3;            // [D] 上身底板厚

// ---------- 頭部 ----------
neckExtra  = 0;        // [D] 頸部加高（方案 C 用 70）
neckZ      = 0;        // [D] 轉軸前後位置
headZ      = 2;        // [D] 頭部中心相對轉軸前移
headW      = 80;       // [D]
headH      = 44;       // [D]
headD      = 48;       // [D]
camTilt    = 10;       // [D] 鏡頭俯角（度）
lensOffset = -20;      // [M] 鏡頭偏離 PCB 中心（負＝天線端）。GOOUUU 相機貼在模組鐵殼上約 -20 → 真鏡頭在右眼
lensH      = 11;       // [M] 鏡頭前緣高出 PCB 正面（相機模組墊在鐵殼上）
eyelid     = 8;        // [D] 表情眼瞼角度（度）
yawMax     = 45;       // [D] 軟體轉頭範圍 ±

// ---------- 列印公差 ----------
tol = 0.3;             // [D] 一般配合間隙
idler_bearing = false; // [D] true = 惰輪壓 624ZZ 軸承；false = 直接套 M4 螺絲
